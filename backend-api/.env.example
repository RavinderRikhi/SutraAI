# Base64-encoded OpenRouter API key (e.g. echo -n 'sk-or-...' | base64 -w0)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
PORT=3000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Prisma CLI only (npm run prisma:push). API runtime uses --pg-connection-string (or --pg-* flags).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
