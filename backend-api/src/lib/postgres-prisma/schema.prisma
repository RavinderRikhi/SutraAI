generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id             String  @id @default(uuid()) @db.Uuid
  businessName   String
  subdomainSlug  String  @unique
  contactEmail   String
  jsonState      Json    @default("{}") @db.JsonB
  isActive       Boolean @default(true)
  planType       String
}
